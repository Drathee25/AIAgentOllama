# --- Google Sheets ---
# Full JSON key of a Google service account with access to the sheet
# (paste as a single-line JSON string).
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}
# The spreadsheet ID from its URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=

# --- Ollama ---
# URL of a remote, reachable Ollama server. Netlify Functions cannot host
# Ollama itself (no persistent process/GPU), so this must point at a server
# you run elsewhere (VPS, home server + tunnel, etc.) with the port exposed
# over HTTPS.
OLLAMA_URL=https://your-ollama-host.example.com
OLLAMA_MODEL=llama3

# --- Email (Resend) ---
RESEND_API_KEY=
# Must be a verified sender/domain in your Resend account.
EMAIL_FROM="Trip Planner <itinerary@yourdomain.com>"

# --- Misc ---
# Max sheet rows processed per function invocation, to stay within the
# background function's 15-minute execution limit (each itinerary can take
# several minutes depending on your Ollama model/hardware).
MAX_ROWS_PER_RUN=3
